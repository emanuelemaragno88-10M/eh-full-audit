{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://*.myshopify.com https://admin.shopify.com;"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://admin.shopify.com"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth/callback", "destination": "/api/auth/callback" }
  ]
}
